# Entorno
NODE_ENV=development

# Puerto del servidor
PORT=4000

# Cadena de conexión PostgreSQL (Neon) para desarrollo
DATABASE_URL="postgresql://USUARIO:CONTRASENA@ep-XXXX.region.aws.neon.tech/neondb?sslmode=require"

# Base de datos aislada para los tests (crea "neondb_test" en el mismo proyecto Neon)
TEST_DATABASE_URL="postgresql://USUARIO:CONTRASENA@ep-XXXX.region.aws.neon.tech/neondb_test?sslmode=require"

# Credenciales del administrador inicial (SOLO DESARROLLO)
# Copia este archivo a .env y cambia los valores
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contrasena

# Secreto para firmar JWT (se usará en la etapa de autenticación)
JWT_SECRET=genera-un-secreto-largo-y-aleatorio

# Origen permitido para CORS (en desarrollo: Vite). En producción se sirve desde el mismo dominio.
FRONTEND_ORIGIN=http://localhost:5173

# Marcar la cookie como Secure (poner true solo en HTTPS/producción)
COOKIE_SECURE=false